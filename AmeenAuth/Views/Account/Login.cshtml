@model AmeenAuth.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-card">
    <div class="auth-brand">
        <div class="auth-logo" aria-hidden="true">
            @* Stylized lotus-style mark (inline SVG) *@
            <svg viewBox="0 0 64 64" width="56" height="56" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="lg" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" style="stop-color:#ec407a;stop-opacity:1" />
                        <stop offset="100%" style="stop-color:#880e4f;stop-opacity:1" />
                    </linearGradient>
                </defs>
                <path fill="url(#lg)" d="M32 8c-4 8-12 14-12 24 0 6 4 10 10 12-2-4-2-8 2-14 4 6 4 10 2 14 6-2 10-6 10-12 0-10-8-16-12-24z" />
                <path fill="url(#lg)" opacity=".85" d="M14 36c6 0 12-4 14-10-6 2-10 6-14 10z" />
                <path fill="url(#lg)" opacity=".85" d="M50 36c-6 0-12-4-14-10 6 2 10 6 14 10z" />
            </svg>
        </div>
        <h1 class="auth-title">Ameen</h1>
    </div>

    <form asp-controller="Account" asp-action="Login" method="post" novalidate>
        @* Anti-forgery token is emitted automatically by the form tag helper *@
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="text-danger small-validation mb-3" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label auth-label"></label>
            <input asp-for="Email" class="form-control auth-input" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="text-danger small-validation"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Password" class="form-label auth-label"></label>
            <div class="auth-password-wrap">
                <input asp-for="Password" id="Password" class="form-control auth-input pe-5" autocomplete="current-password" />
                <button type="button" class="auth-toggle-pw" id="togglePw" aria-label="Show password">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" />
                        <path d="M11.297 9.176a3 3 0 0 0-4.474-4.474l.823.823a2 2 0 0 1 2.829 2.829l-.822.822z" />
                        <path d="m13.646 14.354-12-12 .708-.708 12 12-.708.708z" />
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger small-validation"></span>
        </div>

        <div class="d-flex justify-content-end auth-forgot mb-3">
            <a href="#">Forgot password?</a>
        </div>

        <div class="form-check mb-4 auth-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-auth-login">Login</button>
    </form>

    <p class="auth-footer mb-0">
        No account? <a href="#">Sign up</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const input = document.getElementById("Password");
            const btn = document.getElementById("togglePw");
            if (!input || !btn) return;
            btn.addEventListener("click", function () {
                const show = input.type === "password";
                input.type = show ? "text" : "password";
                btn.setAttribute("aria-label", show ? "Hide password" : "Show password");
            });
        })();
    </script>
}
