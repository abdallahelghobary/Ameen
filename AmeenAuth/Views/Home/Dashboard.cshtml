@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<!-- Dashboard Cards Grid -->
<div class="dashboard-grid">
    <!-- Total Data Stored -->
    <div class="dashboard-card">
        <div class="card-header">
            <span class="card-title">Total Data Stored</span>
        </div>
        <div class="card-value">$34,076.78K</div>
        <div class="progress-bar-custom">
            <div class="progress-fill" style="width: 65%"></div>
        </div>
        <div class="card-footer">
            <span>256.3B</span>
            <span>Feb</span>
        </div>
    </div>

    <!-- Growth Rate -->
    <div class="dashboard-card">
        <div class="card-header">
            <span class="card-title">Growth Rate</span>
        </div>
        <div class="card-value" style="color: #e91e63;">📈 102%</div>
        <div class="card-subtitle">Active</div>
        <div class="card-footer">
            <span>Avg: 2.4</span>
        </div>
    </div>

    <!-- Recent AI Insights -->
    <div class="dashboard-card">
        <div class="card-header">
            <span class="card-title">Recent AI Insights</span>
        </div>
        <ul class="insights-list">
            <li class="insight-item">
                <span class="insight-icon">📍</span>
                <span class="insight-text">Desperat atasodile insights alarmisire s0d fra roared in atque</span>
            </li>
            <li class="insight-item">
                <span class="insight-icon">📍</span>
                <span class="insight-text">Desperat atasodile insights alarmisire s0d fra roared in atque</span>
            </li>
            <li class="insight-item">
                <span class="insight-icon">📍</span>
                <span class="insight-text">Desperat atasodile insights alarmisire s0d fra roared in atque</span>
            </li>
            <li class="insight-item">
                <span class="insight-icon">📍</span>
                <span class="insight-text">Desperat atasodile insights alarmisire s0d fra roared in atque</span>
            </li>
        </ul>
        <button class="btn-generate">Generate AI Insights</button>
    </div>
</div>

<!-- Two Column Grid -->
<div class="dashboard-grid-2">
    <!-- Progress Rate -->
    <div class="dashboard-card">
        <div class="card-header">
            <span class="card-title">Progress Rate</span>
            <span class="card-meta">High Confidence</span>
        </div>
        <div class="card-value">$150 - 120%</div>
        <div class="progress-bar-custom">
            <div class="progress-fill" style="width: 85%"></div>
        </div>
        <div class="card-footer">
            <span>Deal Bid Charge</span>
            <span>2/3 6m0</span>
        </div>
    </div>

    <!-- Data Chart -->
    <div class="dashboard-card">
        <div class="card-header">
            <span class="card-title">Data Chart</span>
        </div>
        <div class="chart-container">
            <svg viewBox="0 0 400 150" style="width: 100%; height: 100%;">
                <!-- Chart background -->
                <defs>
                    <linearGradient id="chartGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" style="stop-color:#e91e63;stop-opacity:0.3" />
                        <stop offset="100%" style="stop-color:#e91e63;stop-opacity:0" />
                    </linearGradient>
                </defs>
                <!-- Grid -->
                <line x1="0" y1="30" x2="400" y2="30" stroke="#2d3547" stroke-width="1" />
                <line x1="0" y1="60" x2="400" y2="60" stroke="#2d3547" stroke-width="1" />
                <line x1="0" y1="90" x2="400" y2="90" stroke="#2d3547" stroke-width="1" />
                <line x1="0" y1="120" x2="400" y2="120" stroke="#2d3547" stroke-width="1" />
                
                <!-- Chart line -->
                <polyline points="10,100 60,80 110,70 160,60 210,55 260,45 310,30 360,20" 
                    fill="none" stroke="#e91e63" stroke-width="2" stroke-linecap="round" />
                
                <!-- Fill area -->
                <polygon points="10,100 60,80 110,70 160,60 210,55 260,45 310,30 360,20 360,140 10,140" 
                    fill="url(#chartGradient)" />
                
                <!-- Axis labels -->
                <text x="10" y="145" fill="#a0aec0" font-size="10">Jan</text>
                <text x="60" y="145" fill="#a0aec0" font-size="10">Feb</text>
                <text x="110" y="145" fill="#a0aec0" font-size="10">Mar</text>
                <text x="160" y="145" fill="#a0aec0" font-size="10">Apr</text>
                <text x="210" y="145" fill="#a0aec0" font-size="10">May</text>
                <text x="260" y="145" fill="#a0aec0" font-size="10">Jun</text>
            </svg>
        </div>
    </div>
</div>

<!-- Pie Chart Row -->
<div class="dashboard-grid">
    <div class="dashboard-card">
        <div class="card-header">
            <span class="card-title">Pie Chart</span>
        </div>
        <div class="chart-container">
            <svg viewBox="0 0 200 200" style="width: 100%; height: 100%; max-width: 150px; margin: 0 auto; display: block;">
                <!-- Donut Chart -->
                <defs>
                    <style>
                        .slice1 { fill: #e91e63; }
                        .slice2 { fill: #f06292; }
                        .slice3 { fill: #f48fb1; }
                        .slice4 { fill: #f8bbd0; }
                        .slice5 { fill: #e91e63; opacity: 0.5; }
                    </style>
                </defs>
                
                <!-- Slices -->
                <path class="slice1" d="M 100,100 L 100,30 A 70,70 0 0,1 159,51 Z" />
                <path class="slice2" d="M 100,100 L 159,51 A 70,70 0 0,1 170,170 Z" />
                <path class="slice3" d="M 100,100 L 170,170 A 70,70 0 0,1 30,170 Z" />
                <path class="slice4" d="M 100,100 L 30,170 A 70,70 0 0,1 30,30 Z" />
                <path class="slice5" d="M 100,100 L 30,30 A 70,70 0 0,1 100,30 Z" />
                
                <!-- Center circle (white inner circle for donut effect) -->
                <circle cx="100" cy="100" r="45" fill="#1a1f3a" />
            </svg>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.min.js" asp-append-version="true"></script>
}
